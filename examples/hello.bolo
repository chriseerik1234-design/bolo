# A quick tour of Bolo.  Run it with:
#     bolo examples/hello.bolo
#
# "say" shows something on the screen. "print" does exactly the same.

# --- text ---------------------------------------------------------------
say("--- text ---")
"tere, maailm" |> upper |> say
"  padded  " |> trim |> length |> say

# --- pipelines ----------------------------------------------------------
# x |> f(a)  is the same as  f(x, a).
say("--- pipelines ---")
[3, 1, 4, 1, 5, 9, 2, 6]
  |> unique
  |> sort
  |> filter({ it % 2 is 0 })
  |> map({ it * 10 })
  |> say

# --- names and choices --------------------------------------------------
say("--- variables and if ---")
name = "Bolo"
say("hello, " + name)

if name |> length > 5 {
  say(name + " is a long name")
} else {
  say(name + " is short")
}

# --- your own tricks ----------------------------------------------------
say("--- functions ---")
to greet(who, greeting) {
  greeting + ", " + who + "!"
}
greet("maailm", "Tere") |> say

to fact(n) {
  if n <= 1 { return 1 }
  n * fact(n - 1)
}
say("5! = " + text(fact(5)))

# --- repeating ----------------------------------------------------------
say("--- loops ---")
for n in range(1, 4) {
  say(text(n) + " squared is " + text(n * n))
}

n = 3
while n > 0 {
  say("{n}...")
  n = n - 1
}

for n in [1, 2, 3, 4, 5] {
  if n is 2 { continue }
  if n is 4 { break }
  say("kept " + text(n))
}

# --- tables -------------------------------------------------------------
say("--- tables ---")
person = table("name", "Mari", "age", 12)
person["city"] = "Tartu"
put(person, "job", "student")
say("{person['name']} is {person['age']} and lives in {person['city']}.")
say("keys: " + text(keys(person)))
for key, value in pairs(person) {
  say("  " + key + " = " + text(value))
}

# --- catching problems --------------------------------------------------
say("--- try / catch ---")
try {
  fail("something we planned for")
} catch problem {
  say("caught: " + problem)
}

# --- small recipes as values -------------------------------------------
say("--- lambdas as values ---")
double = { it * 2 }
[1, 2, 3] |> map(double) |> say

add = { a, b -> a + b }
[1, 2, 3, 4] |> reduce(0, add) |> say
